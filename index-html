    <script>
        // Curated Kenyan Music Tracks Queue
        const kenyanTracks = [
            { title: "Kwangwaru & East Africa Hits Mix", artist: "Kenyan Bongo & Afro Hits", genre: "Bongo / Afro-Pop" },
            { title: "Gengetone Fire Wave 2026", artist: "Nairobi Top Gengetone Stars", genre: "Gengetone" },
            { title: "Nairobi Nights & Chill Beats", artist: "Kenyan Urban Afrobeat", genre: "Afro-Pop" },
            { title: "Swahili Praise & Gospel Vibe", artist: "Kenyan Gospel Hits", genre: "Swahili Gospel" },
            { title: "Rhumba & Benga Classics", artist: "Kenyan Legends Collection", genre: "Benga Classic" }
        ];

        let currentTrackIndex = 0;
        let isMuted = false;

        // Update Live Clock at Bottom Left
        function updateLiveClock() {
            const clockEl = document.getElementById('liveClock');
            const now = new Date();
            
            // Format time string
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            
            hours = hours % 12;
            hours = hours ? hours : 12; // hour '0' should be '12'
            const formattedHours = String(hours).padStart(2, '0');

            clockEl.textContent = `${formattedHours}:${minutes}:${seconds} ${ampm}`;
        }

        // Render Upcoming Track Queue
        function renderTrackQueue() {
            const queueEl = document.getElementById('trackQueue');
            queueEl.innerHTML = kenyanTracks.map((track, idx) => `
                <div class="p-2.5 rounded-xl bg-rkb-panel border ${idx === currentTrackIndex ? 'border-rkb-red bg-rkb-red/10' : 'border-rkb-border'} flex items-center justify-between">
                    <div class="min-w-0 flex items-center gap-2">
                        <span class="text-[10px] font-bold ${idx === currentTrackIndex ? 'text-rkb-red' : 'text-slate-500'} font-mono">0${idx+1}</span>
                        <div class="truncate">
                            <div class="font-bold text-white truncate">${track.title}</div>
                            <div class="text-[10px] text-slate-400 truncate">${track.artist}</div>
                        </div>
                    </div>
                    <span class="text-[9px] px-2 py-0.5 rounded ${idx === currentTrackIndex ? 'bg-rkb-red text-white font-bold' : 'bg-rkb-border text-slate-400'} shrink-0">
                        ${idx === currentTrackIndex ? 'PLAYING' : track.genre}
                    </span>
                </div>
            `).join('');
        }

        // Toggle Audio
        function toggleStationAudio() {
            const audioIcon = document.getElementById('audioIcon');
            const iframe = document.getElementById('kenyanMusicPlayer');
            
            isMuted = !isMuted;
            if(isMuted) {
                audioIcon.className = "fa-solid fa-volume-xmark text-xs";
                iframe.contentWindow.postMessage('{"event":"command","func":"mute","args":""}', '*');
            } else {
                audioIcon.className = "fa-solid fa-volume-high text-xs";
                iframe.contentWindow.postMessage('{"event":"command","func":"unMute","args":""}', '*');
            }
        }

        // Skip to next track in queue
        function skipNextSong() {
            currentTrackIndex = (currentTrackIndex + 1) % kenyanTracks.length;
            const track = kenyanTracks[currentTrackIndex];
            
            document.getElementById('currentTrackTitle').textContent = track.title;
            document.getElementById('currentTrackArtist').textContent = `${track.artist} • ${track.genre}`;
            
            renderTrackQueue();
        }

        // Send Floating Reaction
        function sendReaction(emoji) {
            if(emoji === '🔥') {
                const count = document.getElementById('countFire');
                count.textContent = (parseFloat(count.textContent) + 0.1).toFixed(1) + 'K';
            } else if(emoji === '🇰🇪') {
                const count = document.getElementById('countKenyan');
                count.textContent = (parseFloat(count.textContent) + 0.1).toFixed(1) + 'K';
            } else {
                const count = document.getElementById('countMusic');
                count.textContent = parseInt(count.textContent) + 1;
            }

            const container = document.getElementById('reactionContainer');
            const bubble = document.createElement('div');
        
