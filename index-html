        /* Seamless video iframe mask to hide YouTube branding/origins */
        .video-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        .video-wrapper iframe {
            position: absolute;
            top: -60px;
            left: -60px;
            width: calc(100% + 120px);
            height: calc(100% + 120px);
            pointer-events: none; /* Disables right-clicks or links revealing youtube origin */
        }

        /* Floating reaction animations */
        @keyframes floatUp {
